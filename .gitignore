bin/
*.dSYM/
__pycache__/
*.pyc
*.o
xdp_agg/*.o
xdp_agg/*.ll
.claude/

# fuzz/ build output and libFuzzer's own coverage-increasing corpus growth
# -- fuzz/corpus/ itself (the hand-picked seeds) IS tracked; only the
# compiled binary and libFuzzer's own findings/crash artifacts are not.
fuzz/fuzz_grad_parse
fuzz/*.dSYM/
fuzz/findings/
fuzz/corpus/regressions/
fuzz/crash-*
fuzz/oom-*
fuzz/timeout-*
